{
  "expo": {
    "name": "Little Learners",
    "slug": "little-learners",
    "scheme": "littlelearners",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": { "typedRoutes": true },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.example.littlelearners" },
    "android": { "package": "com.example.littlelearners", "adaptiveIcon": { "backgroundColor": "#FFF4D8" } }
  }
}
